{
  "expo": {
    "name": "ReelEarn",
    "slug": "reelearn",
    "scheme": "reelearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.reelearn",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile photo.",
        "NSCameraUsageDescription": "Take a profile photo."
      }
    },
    "android": {
      "package": "app.reelearn"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo.",
          "cameraPermission": "Take a profile photo."
        }
      ]
    ]
  }
}